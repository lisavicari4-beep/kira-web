# KIRA — environment template
# Copy to .env.local for development.

# Public site URL (used in OG/canonical/sitemap)
NEXT_PUBLIC_SITE_URL=https://kira.app

# Anthropic API key — powers the AI Smart Search ("Ask KIRA").
# If unset, /api/search falls back to a deterministic mock so dev still works.
ANTHROPIC_API_KEY=

# Jikan (MAL) is keyless. AniList is keyless for read.
# Add a paid AniList key here if you ever exceed the public rate limits.
ANILIST_TOKEN=

# Age-gate cookie name + max age (seconds). 90 days default.
KIRA_AGE_COOKIE=kira_18
KIRA_AGE_MAX_AGE=7776000
